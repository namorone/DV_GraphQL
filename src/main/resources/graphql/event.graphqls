type Query {
  """Список останніх N подій (за замовчуванням 10)"""
  recentEvents(limit: Int = 10): [Event!]!

  """Отримати подію за ID"""
  event(id: ID!): Event
}

type Event {
  id: ID!
  message: String!
  timestamp: String!
}

type Mutation {
  createEvent(message: String!): Event
}

type Subscription {
  eventCreated: Event
}
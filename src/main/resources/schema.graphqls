type Query {
  # Повертає всі книги або фільтровані за заголовком (аргумент title)
  books(title: String): [Book]

  # Повертає книгу за її ідентифікатором
  bookById(id: ID!): Book
}

type Mutation {
  # Мутація для оновлення книги, приймає вхідний об'єкт UpdateBookInput
  updateBook(input: UpdateBookInput!): Book
}

# Три рівні вкладеності: Book -> Author -> Biography
type Book {
  id: ID!
  title: String!
  author: Author!
}

type Author {
  id: ID!
  name: String!
  biography: Biography
}

type Biography {
  text: String!
}

# Вхідний тип, який використовується як аргумент для мутації
input UpdateBookInput {
  id: ID!
  title: String
}
